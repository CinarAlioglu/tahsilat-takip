<ui:FluentWindow x:Class="TahsilatTakip.App.Pencereler.AnaPencere"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:s="clr-namespace:TahsilatTakip.App.Sayfalar"
                 Title="Tahsilat Takip" Width="1280" Height="800" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen" WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Baslik" Grid.Row="0" Title="Tahsilat Takip">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Wallet24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Gezinti" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="230"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True"
                           FrameMargin="0" Padding="24,8,24,24">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Ana panel" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type s:AnaPanelSayfasi}" />
                <ui:NavigationViewItem Content="Mükellefler" Icon="{ui:SymbolIcon People24}"
                                       TargetPageType="{x:Type s:MukelleflerSayfasi}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Ayarlar" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type s:AyarlarSayfasi}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="12,8">
                    <TextBlock x:Name="KullaniciMetni" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <ui:Button Content="Çıkış yap" Appearance="Transparent" Padding="0,4" Margin="0,4,0,0"
                               Click="Cikis_Click" Icon="{ui:SymbolIcon SignOut24}" />
                </StackPanel>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
