<ui:FluentWindow x:Class="TahsilatTakip.App.Pencereler.GirdiPenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="460" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar x:Name="Baslik" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,0,24,24">
            <TextBlock x:Name="Aciklama" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ui:TextBox x:Name="Girdi" AcceptsReturn="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" />
                <ui:Button x:Name="Tamam" Content="Tamam" Appearance="Primary" IsDefault="True" Click="Tamam_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
