<ui:FluentWindow x:Class="TahsilatTakip.App.Pencereler.GrupTahsilatPenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Grup tahsilatı" Width="640" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Grup tahsilatı al" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,0,24,24">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding GrupAdi}" />
            <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding BakiyeMetni}" Foreground="#C42B1C" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Tarih *" />
                    <DatePicker SelectedDate="{Binding Tarih}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Toplam tutar (₺) *" />
                    <ui:TextBox x:Name="TutarKutusu" Text="{Binding Tutar, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Ödeme yöntemi" />
                    <ComboBox ItemsSource="{Binding Yontemler}" SelectedItem="{Binding Yontem}" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Tahsil eden" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding TahsilEdenler}" Text="{Binding TahsilEden, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Paranın geldiği yer" />
                    <ComboBox IsEditable="True" ItemsSource="{Binding Hesaplar}" Text="{Binding Hesap, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Ödeyen kişi" />
            <ui:TextBox Text="{Binding OdeyenKisi}" />
            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Açıklama" />
            <ui:TextBox Text="{Binding Aciklama}" />
            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Dekont" />
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon Attach24}" Content="Dosya seç..." Command="{Binding DekontSecCommand}" />
                <TextBlock Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DekontAdi}" />
            </DockPanel>

            <TextBlock Style="{StaticResource AltBaslik}" Margin="0,16,0,4" Text="Üyelere dağılım" />
            <DataGrid Style="{StaticResource Tablo}" ItemsSource="{Binding Dagilim}" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="*" />
                    <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat=N2}" Width="120" ElementStyle="{StaticResource SagaYasli}" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" />
                <ui:Button Content="Kaydet" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding KaydetCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
