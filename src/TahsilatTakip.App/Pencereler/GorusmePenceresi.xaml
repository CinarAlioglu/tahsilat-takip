<ui:FluentWindow x:Class="TahsilatTakip.App.Pencereler.GorusmePenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:k="clr-namespace:TahsilatTakip.App.Kontroller"
                 Title="Görüşme ekle" Width="600" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Görüşme / ödeme sözü ekle" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,0,24,24">
            <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0,0,0,4" Text="Mükellef *" />
            <k:MukellefSecici x:Name="MukellefKutusu" Mukellefler="{Binding Mukellefler}" Secili="{Binding SeciliMukellef}"
                              Visibility="{Binding MukellefSabit, Converter={StaticResource BoolGizli}}" />
            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SeciliMukellef.Unvan}"
                       Visibility="{Binding MukellefSabit, Converter={StaticResource BoolGorunur}}" />
            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding BakiyeMetni}"
                       Foreground="{Binding SeciliMukellef.Bakiye, Converter={StaticResource BakiyeRengi}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Görüşme tarihi" />
                    <DatePicker SelectedDate="{Binding Tarih}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Nasıl görüşüldü" />
                    <ComboBox ItemsSource="{Binding Kanallar}" SelectedItem="{Binding Kanal}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Ne konuşuldu *" />
            <ui:TextBox x:Name="NotKutusu" Text="{Binding Not, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                        TextWrapping="Wrap" MinLines="3" PlaceholderText="Ör. Arandı, firmadan alacağını tahsil edince ödeyecekmiş." />

            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox Content="Ödeme sözü verdi" IsChecked="{Binding SozVar}" />
                    <Grid Margin="0,4,0,0" Visibility="{Binding SozVar, Converter={StaticResource BoolGorunur}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Ne zaman ödeyecek *" />
                            <DatePicker SelectedDate="{Binding SozTarihi}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Ne kadar ödeyecek (₺)" />
                            <ui:TextBox Text="{Binding SozTutari}" PlaceholderText="Boşsa herhangi bir ödeme" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding SozVar, Converter={StaticResource BoolGorunur}}"
                               Text="Söz tarihine kadar ödeme gelirse söz otomatik 'tutuldu' olur; gelmezse ana panelde uyarı çıkar." />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" />
                <ui:Button Content="Kaydet" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding KaydetCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
