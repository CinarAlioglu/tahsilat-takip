<ui:FluentWindow x:Class="TahsilatTakip.App.Pencereler.BorcPenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Elle borç ekle" Width="560" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Elle borç ekle" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,0,24,24">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Ücret planı dışındaki borçlar için: şirket kuruluşu, SGK işlemi, defter tasdiki vb. Aylık ücretler ücret planından otomatik yazılır." />
            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Mükellef *" />
            <ComboBox x:Name="MukellefKutusu" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Unvan"
                      ItemsSource="{Binding Mukellefler}" DisplayMemberPath="Unvan"
                      SelectedItem="{Binding SeciliMukellef}" Visibility="{Binding MukellefSabit, Converter={StaticResource BoolGizli}}" />
            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SeciliMukellef.Unvan}"
                       Visibility="{Binding MukellefSabit, Converter={StaticResource BoolGorunur}}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Hizmet" />
                    <ComboBox ItemsSource="{Binding Hizmetler}" DisplayMemberPath="Ad" SelectedItem="{Binding Hizmet}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Borç tarihi *" />
                    <DatePicker SelectedDate="{Binding Tarih}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource AlanEtiketi}" Text="Tutar (₺) *" />
                    <ui:TextBox Text="{Binding Tutar}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource AlanEtiketi}" Text="Açıklama *" />
            <ui:TextBox Text="{Binding Aciklama}" PlaceholderText="Ör. 2026 yılı defter tasdiki" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" />
                <ui:Button Content="Kaydet" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" IsDefault="True"
                           Command="{Binding KaydetCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
