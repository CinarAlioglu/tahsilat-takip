<ui:FluentWindow x:Class="TahsilatTakip.App.Pencereler.DevirPenceresi"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Toplu devir girişi" Width="1150" Height="760"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Toplu devir girişi" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,12">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Uygulamaya geçmeden önceki kalan borçları girin. Yalnızca tutar yazdığınız satırlar kaydedilir; borcu olmayanları boş bırakın. Sağdaki notlar Excel'den aktarılan açıklamalardır." />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Devir tarihi:" />
                <DatePicker Width="140" SelectedDate="{Binding Tarih}" />
                <CheckBox Margin="24,0,0,0" VerticalAlignment="Center" Content="Devri girilmiş olanları gizle"
                          IsChecked="{Binding GirilenleriGizle}" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" Margin="24,0" ItemsSource="{Binding Gorunen}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" SelectionUnit="Cell">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="300" IsReadOnly="True" />
                <DataGridTextColumn Header="Girilmiş devir" Binding="{Binding MevcutDevir, StringFormat='{}{0:#,##0.00;;#}'}"
                                    Width="110" IsReadOnly="True" ElementStyle="{StaticResource SagaYasli}" />
                <DataGridTextColumn Header="Devir tutarı (₺)" Binding="{Binding Tutar, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                <DataGridTextColumn Header="Notlar" Binding="{Binding Notlar}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="24,12,24,24">
            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                       Content="Devirleri kaydet" Command="{Binding KaydetCommand}" />
            <ui:Button DockPanel.Dock="Right" Margin="0,0,8,0" Content="Vazgeç" IsCancel="True" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Ozet}" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
