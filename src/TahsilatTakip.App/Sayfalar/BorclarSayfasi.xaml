<Page x:Class="TahsilatTakip.App.Sayfalar.BorclarSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Borçlar">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource SayfaBasligi}" Text="Borçlar (tahakkuklar)" />

        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Borç tarihi:" />
            <DatePicker DockPanel.Dock="Left" Width="130" SelectedDate="{Binding Baslangic}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0" Text="–" />
            <DatePicker DockPanel.Dock="Left" Width="130" SelectedDate="{Binding Bitis}" />
            <ui:TextBox DockPanel.Dock="Left" Width="220" Margin="16,0,0,0" PlaceholderText="Mükellef ara..."
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        Text="{Binding Arama, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Content="Sadece ödenmemişler"
                      IsChecked="{Binding SadeceAcik}" />
            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Content="İptalleri göster"
                      IsChecked="{Binding IptalDahil}" />
            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                       Content="Elle borç ekle" Command="{Binding YeniCommand}" />
        </DockPanel>

        <DataGrid Grid.Row="2" Style="{StaticResource Tablo}" ItemsSource="{Binding Gorunen}" SelectedItem="{Binding Secili}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IptalEdildi}" Value="True">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="ToolTip" Value="{Binding IptalNedeni}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Borç tarihi" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="100" />
                <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="*" />
                <DataGridTextColumn Header="Hizmet" Binding="{Binding Hizmet}" Width="150" />
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" />
                <DataGridTextColumn Header="Kaynak" Binding="{Binding Kaynak, Converter={StaticResource EnumAciklama}}" Width="80" />
                <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat=N2}" Width="110"
                                    ElementStyle="{StaticResource SagaYasli}" />
                <DataGridTemplateColumn Header="Kalan" Width="110" SortMemberPath="Kalan">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SagaYasli}" FontWeight="SemiBold"
                                       Text="{Binding Kalan, StringFormat=N2}"
                                       Foreground="{Binding Kalan, Converter={StaticResource BakiyeRengi}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Delete24}" Content="Seçili borcu iptal et"
                       Command="{Binding IptalCommand}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Ozet}" />
        </DockPanel>
    </Grid>
</Page>
