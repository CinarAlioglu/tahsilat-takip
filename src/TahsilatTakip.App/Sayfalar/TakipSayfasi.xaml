<Page x:Class="TahsilatTakip.App.Sayfalar.TakipSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Takip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Primary" Icon="{ui:SymbolIcon Call24}"
                       Content="Görüşme ekle" Command="{Binding GorusmeEkleCommand}" />
            <TextBlock Style="{StaticResource SayfaBasligi}" Text="Takip" />
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding Sekme}">
            <!-- ============ Gecikenler ============ -->
            <TabItem Header="{Binding GecikenBasligi}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <ui:TextBox DockPanel.Dock="Left" Width="260" PlaceholderText="Mükellef ara..." Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True" Text="{Binding Arama, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Content="Vadesi gelmemiş borcu olanları da göster" IsChecked="{Binding TumBorclular}" />
                    </DockPanel>
                    <DataGrid x:Name="GecikenTablosu" Grid.Row="1" Style="{StaticResource Tablo}" ItemsSource="{Binding Gecikenler}"
                              SelectedItem="{Binding SeciliGeciken}" MouseDoubleClick="Geciken_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="2*" />
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="110" />
                            <DataGridTextColumn Header="Gecikme" Binding="{Binding GecikmeGunu, StringFormat='{}{0:0 gün;;#}'}" Width="80"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTextColumn Header="0-30 gün" Binding="{Binding Gun0_30, StringFormat='{}{0:#,##0;;#}'}" Width="85"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTextColumn Header="31-60" Binding="{Binding Gun31_60, StringFormat='{}{0:#,##0;;#}'}" Width="80"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTextColumn Header="61-90" Binding="{Binding Gun61_90, StringFormat='{}{0:#,##0;;#}'}" Width="80"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTextColumn Header="90+" Binding="{Binding Gun90Ustu, StringFormat='{}{0:#,##0;;#}'}" Width="80"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTemplateColumn Header="Bakiye" Width="110" SortMemberPath="Bakiye">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SagaYasli}" FontWeight="SemiBold" Text="{Binding Bakiye, StringFormat=N2}"
                                                   Foreground="{Binding Bakiye, Converter={StaticResource BakiyeRengi}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Söz" Binding="{Binding SozMetni}" Width="100" />
                            <DataGridTextColumn Header="Son görüşme" Binding="{Binding SonGorusme, StringFormat=dd.MM.yyyy}" Width="100" />
                            <DataGridTextColumn Header="Not" Binding="{Binding SonGorusmeNotu}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="Hatırlatma mesajını kopyala" Command="{Binding MesajKopyalaCommand}" />
                            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon DocumentPdf24}" Content="PDF ekstre" Command="{Binding PdfCommand}" />
                            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Call24}" Content="Görüşme ekle" Command="{Binding SeciliyeGorusmeCommand}" />
                            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ReceiptMoney24}" Content="Tahsilat al" Command="{Binding SeciliyeTahsilatCommand}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GecikenOzeti}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ Ödeme sözleri ============ -->
            <TabItem Header="{Binding SozBasligi}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Takipteki sözler" IsChecked="{Binding SadeceTakiptekiSozler}" GroupName="Soz" />
                        <RadioButton Margin="16,0,0,0" Content="Tüm görüşmeler" GroupName="Soz" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource Tablo}" ItemsSource="{Binding Sozler}" SelectedItem="{Binding SeciliSoz}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SozDurumu}" Value="Tutulmadi">
                                        <Setter Property="Foreground" Value="#C42B1C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SozDurumu}" Value="Tutuldu">
                                        <Setter Property="Foreground" Value="#0F7B0F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Görüşme" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="120" />
                            <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="2*" />
                            <DataGridTextColumn Header="Kanal" Binding="{Binding Kanal, Converter={StaticResource EnumAciklama}}" Width="80" />
                            <DataGridTextColumn Header="Not" Binding="{Binding Not}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Söz" Binding="{Binding SozMetni}" Width="150" />
                            <DataGridTextColumn Header="Durum" Binding="{Binding SozDurumu, Converter={StaticResource EnumAciklama}}" Width="90" />
                            <DataGridTextColumn Header="Kaydeden" Binding="{Binding Kaydeden}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button Icon="{ui:SymbolIcon Checkmark24}" Content="Tutuldu say" Command="{Binding SozTutulduCommand}" />
                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Dismiss24}" Content="Tutulmadı say" Command="{Binding SozTutulmadiCommand}" />
                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Call24}" Content="Yeniden görüş" Command="{Binding SozaGorusmeCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
