<Page x:Class="TahsilatTakip.App.Sayfalar.AnaPanelSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ana panel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Appearance="Primary" Icon="{ui:SymbolIcon ReceiptMoney24}"
                           Content="Tahsilat al" Command="{Binding TahsilatAlCommand}" />
                <TextBlock Style="{StaticResource SayfaBasligi}" Text="Ana panel" />
            </DockPanel>

            <UniformGrid Columns="4" Margin="-6,0">
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Aktif mükellef" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding AktifMukellef}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Toplam alacak" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding ToplamAlacak, StringFormat={}{0:N0} ₺}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Ödemesi geciken" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding GecikenSayisi}"
                                   Foreground="{Binding GecikenSayisi, Converter={StaticResource BakiyeRengi}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Fazla ödeme (avans)" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding ToplamAvans, StringFormat={}{0:N0} ₺}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Ödeme sözleri ve teslim -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="Takip ekranına git →" Click="TakipeGit_Click" />
                            <TextBlock Style="{StaticResource AltBaslik}" Text="Ödeme sözleri" />
                        </DockPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SozOzeti}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding YakinSozler}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SozDurumu, Converter={StaticResource EnumAciklama}}" Width="80" />
                                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{Binding SozTarihi, StringFormat=dd.MM.yyyy}" />
                                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Unvan}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="2" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AltBaslik}" Text="Ofise teslim bekleyen" />
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding TeslimTutari, StringFormat={}{0:N0} ₺}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding TeslimOzeti}" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Otomatik borç yazma -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                                   Content="Borçları yaz" Command="{Binding BorclariYazCommand}"
                                   Visibility="{Binding BekleyenVar, Converter={StaticResource BoolGorunur}}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource AltBaslik}" Text="Yazılmayı bekleyen borçlar" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="{Binding BekleyenOzeti}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Style="{StaticResource Tablo}" ItemsSource="{Binding BekleyenBorclar}" MaxHeight="320"
                              Margin="0,12,0,0" Visibility="{Binding BekleyenVar, Converter={StaticResource BoolGorunur}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Borç tarihi" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="110" />
                            <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="*" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" />
                            <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat=N2}" Width="120"
                                                ElementStyle="{StaticResource SagaYasli}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <!-- En yüksek bakiyeler -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource AltBaslik}" Text="En yüksek borç bakiyeleri" />
                    <DataGrid Style="{StaticResource Tablo}" ItemsSource="{Binding EnYuksekBakiyeler}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="*" />
                            <DataGridTextColumn Header="Ücret" Binding="{Binding UcretBilgisi}" Width="160" />
                            <DataGridTextColumn Header="Gecikme" Binding="{Binding GecikmeGunu, StringFormat='{}{0:0 gün;;#}'}" Width="120"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTextColumn Header="Bakiye" Binding="{Binding Bakiye, StringFormat=N2}" Width="140"
                                                ElementStyle="{StaticResource SagaYasli}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding YedekBilgisi}" />
        </StackPanel>
    </ScrollViewer>
</Page>
