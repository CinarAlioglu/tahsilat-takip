<Page x:Class="TahsilatTakip.App.Sayfalar.AnaPanelSayfasi"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ana panel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Style="{StaticResource SayfaBasligi}" Text="Ana panel" />

            <UniformGrid Columns="4" Margin="-6,0">
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Aktif mükellef" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding AktifMukellef}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Toplam alacak" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding ToplamAlacak, StringFormat={}{0:N0} ₺}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Ödemesi geciken" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding GecikenSayisi}"
                                   Foreground="{Binding GecikenSayisi, Converter={StaticResource BakiyeRengi}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AlanEtiketi}" Margin="0" Text="Fazla ödeme (avans)" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding ToplamAvans, StringFormat={}{0:N0} ₺}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Otomatik borç yazma -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                                   Content="Borçları yaz" Command="{Binding BorclariYazCommand}"
                                   Visibility="{Binding BekleyenVar, Converter={StaticResource BoolGorunur}}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource AltBaslik}" Text="Yazılmayı bekleyen borçlar" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="{Binding BekleyenOzeti}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Style="{StaticResource Tablo}" ItemsSource="{Binding BekleyenBorclar}" MaxHeight="320"
                              Margin="0,12,0,0" Visibility="{Binding BekleyenVar, Converter={StaticResource BoolGorunur}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Borç tarihi" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy}" Width="110" />
                            <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="*" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" />
                            <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat=N2}" Width="120"
                                                ElementStyle="{StaticResource SagaYasli}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <!-- En yüksek bakiyeler -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource AltBaslik}" Text="En yüksek borç bakiyeleri" />
                    <DataGrid Style="{StaticResource Tablo}" ItemsSource="{Binding EnYuksekBakiyeler}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mükellef" Binding="{Binding Unvan}" Width="*" />
                            <DataGridTextColumn Header="Ücret" Binding="{Binding UcretBilgisi}" Width="160" />
                            <DataGridTextColumn Header="Gecikme (gün)" Binding="{Binding GecikmeGunu}" Width="120"
                                                ElementStyle="{StaticResource SagaYasli}" />
                            <DataGridTextColumn Header="Bakiye" Binding="{Binding Bakiye, StringFormat=N2}" Width="140"
                                                ElementStyle="{StaticResource SagaYasli}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>

            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding YedekBilgisi}" />
        </StackPanel>
    </ScrollViewer>
</Page>
